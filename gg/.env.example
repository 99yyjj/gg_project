# GG 프로젝트 환경 변수 예시 파일
# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값으로 채워주세요.
# cp .env.example .env
#
# ⚠️ 실제 .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 등록됨).

# =============================================
# Cafe24 API 인증 정보
# Cafe24 개발자 센터(https://developers.cafe24.com)에서 앱 등록 후 발급
# =============================================
CAFE24_CLIENT_ID=your_client_id_here
CAFE24_CLIENT_SECRET=your_client_secret_here
CAFE24_MALL_ID=your_mall_id              # 쇼핑몰 ID (예: mymall)
CAFE24_API_VERSION=2026-03-01

# OAuth2 토큰 — 로그인 시 자동 발급/저장되므로 비워둡니다.
CAFE24_ACCESS_TOKEN=                     # 액세스 토큰 (유효기간 2시간, 자동 발급)
CAFE24_REFRESH_TOKEN=                    # 리프레시 토큰 (자동 갱신에 사용)

# OAuth 인증코드를 받을 콜백 주소
# 카페24 개발자센터의 Redirect URI와 글자까지 동일해야 함
CAFE24_REDIRECT_URI=https://your-domain.com/auth/cafe24/callback

# 앱이 요청하는 권한 범위
CAFE24_SCOPES=mall.read_product,mall.write_product,mall.read_category,mall.write_category,mall.read_order

# =============================================
# 데이터베이스 설정 (PostgreSQL)
# =============================================
# 로컬 개발: postgresql+asyncpg://유저명@localhost/gg_db
# 운영 서버: postgresql+asyncpg://유저명:비밀번호@호스트/gg_db
DATABASE_URL=postgresql+asyncpg://username:password@localhost/gg_db

# =============================================
# 프론트엔드 URL (OAuth 콜백 후 리다이렉트 대상)
# =============================================
# 로컬: http://localhost:3000
# 운영: https://your-domain.com
FRONTEND_URL=https://your-domain.com

# =============================================
# AI 서비스 설정
# Google AI Studio(https://aistudio.google.com)에서 발급
# =============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
AI_MAX_TOKENS=8192
USE_MOCK_AI=False                        # True면 실제 AI 호출 대신 목(mock) 응답 사용
