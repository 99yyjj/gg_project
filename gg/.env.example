# GG 프로젝트 환경 변수 예시 파일
# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값으로 채워주세요.
# cp .env.example .env

# =============================================
# Cafe24 API 인증 정보
# Cafe24 개발자 센터(https://developers.cafe24.com)에서 앱 등록 후 발급
# =============================================
CAFE24_CLIENT_ID= 클라이언트 아이디
CAFE24_CLIENT_SECRET= 클라이언트 시크릿 키
CAFE24_MALL_ID= 쇼핑몰 ID          # 쇼핑몰 ID (예: mymall)
CAFE24_API_VERSION=2026-03-01
CAFE24_ACCESS_TOKEN= access_token    # OAuth2 액세스 토큰 (유효기간 2시간)
CAFE24_REFRESH_TOKEN= refresh_token  # OAuth2 리프레시 토큰 (액세스 토큰 만료 시 자동 갱신에 사용)

# =============================================
# 데이터베이스 설정
# SQLite: 파일 하나가 곧 DB (MVP 개발용)
# =============================================
# 로컬 개발: postgresql+asyncpg://유저명@localhost/gg_db
# 운영 서버: postgresql+asyncpg://유저:비번@호스트/gg_db
DATABASE_URL=postgresql+asyncpg://mac@localhost/gg_db

# =============================================
# AI 서비스 설정
# Anthropic Console(https://console.anthropic.com)에서 발급
# =============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
AI_MAX_TOKENS=2048
